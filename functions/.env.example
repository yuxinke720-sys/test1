# 复制此文件为 functions/.env 并填入你自己的值
#   cp functions/.env.example functions/.env
#
# 全部来自火山引擎方舟（Volcengine Ark）控制台：
#   https://console.volcengine.com/ark
#   → 在线推理 → 自定义推理接入点
#
# 接入点 ID 形如 ep-20260409191516-m6xw9，状态必须是「运行中」。
# 若显示「已停止」，调用会返回 InvalidEndpoint.ClosedEndpoint。

# 通用 API Key（文本 + 视觉共用）
VOLCENGINE_API_KEY=

# 文本模型接入点 —— 写故事。推荐 Doubao-Seed 系列
DOUBAO_MODEL_ID=

# 视觉模型接入点 —— 分析孩子照片的外貌特征。
# 可与 DOUBAO_MODEL_ID 填同一个值（Doubao-Seed 支持多模态）
DOUBAO_VISION_MODEL_ID=

# 文生图模型的独立 API Key。
# 若与文本模型共用同一个 Key，这行留空即可——云函数会回落到 VOLCENGINE_API_KEY。
# 三个 ep- 接入点 ID 都没有默认值，留空会直接报
# "Server config missing: DOUBAO_xxx_MODEL_ID"，不会静默走错端点。
DOUBAO_IMAGE_API_KEY=

# 文生图模型接入点 —— 画插图。推荐 Doubao-Seedream 系列
DOUBAO_IMAGE_MODEL_ID=
